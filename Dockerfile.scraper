# ─────────────────────────────────────────────────────────────────────────────
# coeus-scraper — Scraper worker image
#
# Contains: Playwright/Chromium, extraction_workers/, dagster-pipes
# Spawned dynamically by Dagster via PipesDockerClient for each scrape run.
# ─────────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-scraper.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-scraper.txt

COPY extraction_workers/ /app/extraction_workers/

COPY dagster/pipes/scraper_entrypoint.py /app/main.py

COPY misstcha/ /app/misstcha/

RUN mkdir -p /app/scraping_data

CMD ["python", "/app/main.py"]
