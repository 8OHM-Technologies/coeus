# ─────────────────────────────────────────────────────────────────────────────
# coeus-scraper — Scraper worker image
# ─────────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENV PYTHONPATH="${PYTHONPATH}:/app"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV DBUS_SESSION_BUS_ADDRESS=/dev/null

WORKDIR /app

# 1. Non-interactive apt installation to bypass tzdata hanging prompts
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3-tk python3-dev xvfb \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy dependencies
COPY requirements-scraper.txt .

# 3. Cache PyTorch and dependencies using the base image's pip
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements-scraper.txt

# 4. Install matching browser binaries for playwright
RUN playwright install chromium chrome

# 5. Pre-install SeleniumBase drivers into the image
RUN sbase install uc_driver && sbase install chromedriver

# 4. Copy application layers
COPY extraction_workers/ /app/extraction_workers/
COPY dagster/pipes/scraper_entrypoint.py /app/main.py
COPY misstcha/ /app/misstcha/

RUN mkdir -p /app/scraping_data

CMD ["python", "/app/main.py"]