FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Allow all worker scripts to resolve sibling modules (db.py, utils.py, schemas.py)
ENV PYTHONPATH=/app:/app/extraction_workers

WORKDIR /app

RUN pip install --upgrade pip
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt
RUN playwright install --with-deps chromium

RUN mkdir -p /app/data/scraped_pdfs

COPY extraction_workers/ ./extraction_workers/
COPY misstcha/ ./misstcha/

# CMD ["celery", "-A", "coeus", "worker"]
CMD ["tail", "-f", "/dev/null"]
