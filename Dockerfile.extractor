# ─────────────────────────────────────────────────────────────────────────────
# coeus-extractor — LLM extraction worker image
#
# Contains: llm_extractor.py, schemas, utils, dagster-pipes, openai, pdfplumber
# Spawned dynamically by Dagster via PipesDockerClient for each extract run.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install LLM extraction deps
COPY requirements-extractor.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-extractor.txt

# Copy all extraction workers code
COPY extraction_workers/ /app/extraction_workers/

# Copy the Dagster Pipes entrypoint
COPY dagster/pipes/extractor_entrypoint.py /app/main.py
COPY dagster/pipes/scrub_entrypoint.py /app/scrub_entrypoint.py

# Ensure the shared data directory mount point exists
RUN mkdir -p /app/scraping_data

CMD ["python", "/app/main.py"]
